# ============================================================
# Oral Video Director — Environment Variables Template
# 复制此文件为 .env 并填入你的真实值
# ============================================================

# Anthropic (Claude API) — https://console.anthropic.com
ANTHROPIC_API_KEY=

# Tavily Search API — https://tavily.com
TAVILY_API_KEY=

# TikHub API (竞品监控) — https://tikhub.io
TIKHUB_API_KEY=

# HeyGen (数字人视频生成) — https://app.heygen.com/settings?nav=API
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=        # 在 HeyGen > Avatars 找到你的数字人 ID
HEYGEN_VOICE_ID=         # 在 HeyGen > Voices 找到你的音色 ID

# Blotato (社媒发布) — https://app.blotato.com
BLOTATO_API_KEY=
BLOTATO_IG_ACCOUNT_ID=   # Blotato 后台 > Accounts 找 Instagram 账号 ID
BLOTATO_FB_ACCOUNT_ID=   # Blotato 后台 > Accounts 找 Facebook 账号 ID
BLOTATO_FB_PAGE_ID=      # Facebook Page ID（从 Blotato Accounts 详情获取）

# Airtable — https://airtable.com/create/tokens
AIRTABLE_PAT=
AIRTABLE_BASE_ID=
AIRTABLE_BRAND_CONFIG_TABLE=
AIRTABLE_PIPELINE_TABLE=
AIRTABLE_STATS_TABLE=

# ── 模型分层（可选，留空用默认）──────────────────────────────
# 便宜活（选题/审核/平台改写）与质量活（口播正文/周复盘）分开用模型，省钱不降质
# MODEL_CHEAP=claude-haiku-4-5
# MODEL_QUALITY=claude-sonnet-5   （想更强可改 claude-opus-4-8，成本更高）

# ── 成本护栏 & 告警（可选，留空即关闭）──────────────────────
# 每月 HeyGen 渲染预算上限（美元）；累计到达后自动暂停出视频。留空或 0 = 不限制
MONTHLY_BUDGET_USD=200
# HeyGen 每秒渲染单价（美元），用于累计成本，按你的数字人引擎填：
#   Avatar III 数字孪生≈0.0167 / Avatar III 照片≈0.0433 / Avatar IV 照片≈0.05 / Avatar IV 孪生≈0.0667
HEYGEN_COST_PER_SEC=0.05
# 告警 Webhook（Slack 或 Discord 的 Incoming Webhook URL）；留空 = 只打印不推送
ALERT_WEBHOOK_URL=

# 以下由系统自动填写，安装时留空
AIRTABLE_WEBHOOK_ID=
AIRTABLE_WEBHOOK_SECRET=
MODAL_WEBHOOK_URL=
